// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum AssetType {
  IMAGE
  VIDEO
}

enum AssetStatus {
  PROCESSING
  READY
  FAILED
}

enum CreativePackageStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  FAILED
}

enum CreativeDestination {
  SIGNAGE
  REVIVE
}

/**
 * --- Campaigns ---
 */
enum CampaignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignScheduleType {
  ONE_TIME
  RECURRING
}

enum CampaignTargetType {
  SCREEN
  GROUP
  WALL
}

/**
 * --- Display walls / synchronized clusters ---
 */
enum DisplayWallSceneMode {
  SPAN
  INDEPENDENT
}

enum DisplayWallFailurePolicy {
  HOLD_LAST_READY
  FALLBACK_STANDARD
}

enum DisplayWallReadinessStatus {
  PRELOADING
  READY
  FAILED
}

enum DisplayWallRunStatus {
  PREPARING
  ARMED
  RUNNING
  BLOCKED
  COMPLETE
}

/**
 * --- Structured vendor input ---
 */
enum ContentCollectionType {
  MENU
  DROPS
  EVENTS
}

enum ContentEntryStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

/**
 * --- Playlist widgets ---
 */
enum PlaylistItemKind {
  ASSET
  CREATIVE_PACKAGE
  COLLECTION_WIDGET
  DISPLAY_WALL
}

enum WidgetRenderMode {
  TICKER
  LIST
  GRID
}

model Screen {
  id           String @id @default(cuid())
  screenNumber Int    @unique
  name         String

  deviceId        String?     @unique
  deviceTokenHash String?
  activationCode  String      @unique
  orientation     Orientation
  width           Int
  height          Int
  timezone        String      @default("America/Phoenix")
  lastSeenAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules ScheduleWindow[]
  logs      ProofOfPlayLog[]

  groupMembers         ScreenGroupMember[]
  displayWallMembers   DisplayWallMember[]
  campaignTargets      CampaignTarget[]
  displayWallReadiness DisplayWallReadinessAck[]
}

model ScreenGroup {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         ScreenGroupMember[]
  campaignTargets CampaignTarget[]
}

model ScreenGroupMember {
  id String @id @default(cuid())

  groupId String
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, screenId])
  @@index([screenId])
}

model DisplayWall {
  id          String  @id @default(cuid())
  name        String
  description String?

  rows                   Int                      @default(1)
  columns                Int                      @default(1)
  canvasWidth            Int                      @default(0)
  canvasHeight           Int                      @default(0)
  syncToleranceMs        Int                      @default(80)
  hardResyncMs           Int                      @default(350)
  preloadLeadSec         Int                      @default(300)
  startGuardMs           Int                      @default(5000)
  requireAllMembersReady Boolean                  @default(true)
  failurePolicy          DisplayWallFailurePolicy @default(HOLD_LAST_READY)
  timezone               String                   @default("America/Phoenix")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         DisplayWallMember[]
  creatives       DisplayWallCreative[]
  campaignTargets CampaignTarget[]
  schedules       ScheduleWindow[]
  readinessAcks   DisplayWallReadinessAck[]
  runs            DisplayWallRun[]
}

model DisplayWallMember {
  id String @id @default(cuid())

  wallId String
  wall   DisplayWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  slotIndex Int
  row       Int
  column    Int
  x         Int
  y         Int
  width     Int
  height    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiles DisplayWallCreativeTile[]

  @@unique([wallId, screenId])
  @@unique([wallId, row, column])
  @@unique([wallId, slotIndex])
  @@index([screenId])
}

model Asset {
  id          String      @id @default(cuid())
  name        String
  type        AssetType
  orientation Orientation
  masterUrl   String
  status      AssetStatus @default(PROCESSING)
  durationSec Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renditions    AssetRendition[]
  playlistItems PlaylistItem[]
  logs          ProofOfPlayLog[]

  contentEntries   ContentEntry[]
  creativeVariants CreativeVariant[]
  displayWallTiles DisplayWallCreativeTile[]
}

model AssetRendition {
  id String @id @default(cuid())

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  url      String
  width    Int
  height   Int
  codec    String?
  bitrate  Int?
  filesize Int?

  createdAt DateTime @default(now())
}

model Playlist {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PlaylistItem[]
  schedules ScheduleWindow[]
  campaigns Campaign[]
}

model PlaylistItem {
  id String @id @default(cuid())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   ContentCollection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  creativePackageId String?
  creativePackage   CreativePackage? @relation(fields: [creativePackageId], references: [id], onDelete: Cascade)

  displayWallCreativeId String?
  displayWallCreative   DisplayWallCreative? @relation(fields: [displayWallCreativeId], references: [id], onDelete: Cascade)

  kind       PlaylistItemKind  @default(ASSET)
  renderMode WidgetRenderMode?

  sortOrder   Int @default(0)
  durationSec Int?

  createdAt DateTime @default(now())

  @@index([playlistId, sortOrder])
  @@index([collectionId])
  @@index([creativePackageId])
  @@index([displayWallCreativeId])
}

model CreativePackage {
  id              String                @id @default(cuid())
  name            String
  brand           String
  campaignMessage String?
  cta             String?
  sourceSystem    String                @default("GSPAN_AI_FACTORY")
  sourceJobId     String?
  status          CreativePackageStatus @default(REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants      CreativeVariant[]
  playlistItems PlaylistItem[]

  @@index([status, createdAt])
  @@index([brand, createdAt])
  @@index([sourceJobId])
}

model CreativeVariant {
  id          String              @id @default(cuid())
  packageId   String
  package     CreativePackage     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assetId     String              @unique
  asset       Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  destination CreativeDestination
  presetKey   String
  width       Int
  height      Int

  createdAt DateTime @default(now())

  @@unique([packageId, destination, presetKey])
  @@index([destination, width, height])
}

model DisplayWallCreative {
  id String @id @default(cuid())

  wallId String
  wall   DisplayWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  name         String
  mode         DisplayWallSceneMode @default(SPAN)
  type         AssetType
  status       AssetStatus          @default(PROCESSING)
  masterUrl    String?
  masterWidth  Int?
  masterHeight Int?
  durationSec  Int?
  sourceJobId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiles         DisplayWallCreativeTile[]
  playlistItems PlaylistItem[]

  @@index([wallId, status, createdAt])
  @@index([wallId, mode, status])
  @@index([sourceJobId])
}

model DisplayWallCreativeTile {
  id String @id @default(cuid())

  creativeId String
  creative   DisplayWallCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  memberId String
  member   DisplayWallMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([creativeId, memberId])
  @@index([memberId])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  timezone String   @default("America/Phoenix")
  priority Int      @default(10)
  startAt  DateTime
  endAt    DateTime

  scheduleType        CampaignScheduleType @default(ONE_TIME)
  recurrenceDays      Int[]                @default([])
  recurrenceStartDate String?
  recurrenceEndDate   String?
  dailyStartTime      String?
  dailyEndTime        String?

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets           CampaignTarget[]
  schedules         ScheduleWindow[]
  wallReadinessAcks DisplayWallReadinessAck[]
  wallRuns          DisplayWallRun[]

  @@index([status, startAt, endAt])
}

model CampaignTarget {
  id   String             @id @default(cuid())
  type CampaignTargetType

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  screenId String?
  screen   Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  wallId String?
  wall   DisplayWall? @relation(fields: [wallId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([screenId])
  @@index([groupId])
  @@index([wallId])
}

model ScheduleWindow {
  id String @id @default(cuid())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  displayWallId String?
  displayWall   DisplayWall? @relation(fields: [displayWallId], references: [id], onDelete: SetNull)

  priority Int      @default(10)
  startAt  DateTime
  endAt    DateTime

  occurrenceKey String @default("one-time")

  createdAt DateTime @default(now())

  @@unique([campaignId, screenId, occurrenceKey])
  @@index([screenId, startAt, endAt])
  @@index([campaignId])
  @@index([displayWallId])
}

model DisplayWallReadinessAck {
  id String @id @default(cuid())

  wallId String
  wall   DisplayWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  occurrenceKey   String
  manifestVersion String
  status          DisplayWallReadinessStatus @default(PRELOADING)
  error           String?
  cachedAt        DateTime?
  observedAt      DateTime                   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wallId, campaignId, occurrenceKey, screenId])
  @@index([wallId, campaignId, occurrenceKey, manifestVersion, status])
  @@index([screenId, updatedAt])
}

model DisplayWallRun {
  id String @id @default(cuid())

  wallId String
  wall   DisplayWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  occurrenceKey   String
  manifestVersion String
  status          DisplayWallRunStatus @default(PREPARING)
  releaseAt       DateTime?
  blockedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wallId, campaignId, occurrenceKey])
  @@index([wallId, status, releaseAt])
}

model ProofOfPlayLog {
  id         String  @id @default(cuid())
  playbackId String? @unique

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  startedAt   DateTime
  endedAt     DateTime
  durationSec Int

  createdAt DateTime @default(now())

  @@index([screenId, createdAt])
  @@index([assetId, createdAt])
}

model ContentCollection {
  id          String                @id @default(cuid())
  name        String
  type        ContentCollectionType
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries       ContentEntry[]
  playlistItems PlaylistItem[]
}

model ContentEntry {
  id           String            @id @default(cuid())
  collectionId String
  collection   ContentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  title  String
  body   String?
  status ContentEntryStatus @default(DRAFT)

  startAt DateTime?
  endAt   DateTime?

  assetId String?
  asset   Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collectionId, status])
  @@index([startAt, endAt])
}
